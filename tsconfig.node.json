{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "outDir": "./node_modules/.cache/tsc-node",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "vite.config.ts",
    "folio-static.ts",
    "scripts/blog-taxonomy-check.ts",
    "src/content/blog-taxonomy.ts",
    "src/content/mobile-landing.ts",
    "src/content/about-landing.ts",
    "src/content/authors.ts",
    "src/site.config.ts"
  ]
}
